# Non-secret settings -> ConfigMap "rag-config" (kustomize adds a content hash to the name,
# so changing a value here rolls the pods automatically).
RAG_OFFLINE=false
RAG_CHAT_MODEL=openai:gpt-4.1-mini
RAG_GUARD_MODEL=openai:gpt-4.1-nano
RAG_JUDGE_MODEL=openai:gpt-4.1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_REDIS_URL=redis://redis:6379/0
RAG_CHROMA_HOST=chroma
RAG_CHROMA_PORT=8000
# hybrid retrieval: Chroma (dense) + Elasticsearch BM25, fused with Reciprocal Rank Fusion
RAG_RETRIEVAL_MODE=hybrid
RAG_ELASTICSEARCH_URL=http://elasticsearch:9200
RAG_ELASTICSEARCH_INDEX=northwind_kb
RAG_RRF_K=60
# the ingest Job/CronJob owns the index; API pods never race to build it
RAG_AUTO_INGEST=false
# every conversation must belong to an authenticated user (X-User-Id from the JWT)
RAG_REQUIRE_USER_ID=true
# conversation history (RAG_DATABASE_URL itself is in the Secret: it contains the password)
RAG_DB_POOL_MIN=1
RAG_DB_POOL_MAX=10
RAG_HISTORY_RETENTION_DAYS=90
# save-first questions: heartbeat while answering; the sweep CronJob frees rows of dead pods
RAG_TURN_HEARTBEAT_S=10
RAG_TURN_STALE_AFTER_S=90
RAG_TURN_MAX_ATTEMPTS=3
# global limits, shared through Redis by every replica
RAG_MAX_CONCURRENT_CHATS=60
RAG_MAX_STREAMS_PER_USER=2
RAG_GENERATOR_CONCURRENCY=25
RAG_GUARD_CONCURRENCY=60
RAG_SLOT_WAIT_S=5
RAG_LLM_TIMEOUT_S=20
RAG_GENERATION_TIMEOUT_S=60
RAG_LEASE_TTL_S=30
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=northwind-rag
