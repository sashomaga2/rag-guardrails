# --- Model provider ---------------------------------------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...            # if you switch RAG_CHAT_MODEL to anthropic:...

# --- LangSmith tracing + evaluation -------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=northwind-rag
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU data residency

# --- App settings (all optional; defaults in src/northwind_rag/config.py) -----
RAG_OFFLINE=false
RAG_CHAT_MODEL=openai:gpt-4.1-mini
RAG_GUARD_MODEL=openai:gpt-4.1-nano
RAG_JUDGE_MODEL=openai:gpt-4.1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.25
# Corrective retry: grounding score below this -> retrieve again with wider limits before regenerating (0 disables)
RAG_RERETRIEVE_BELOW_GROUNDING=0.5
# Cross-encoder reranking after hybrid retrieval: local (pip install ".[rerank]"), http (TEI server), none
RAG_RERANKER=local
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANKER=http
# RAG_RERANKER_URL=http://localhost:8081      # docker run -p 8081:80 ghcr.io/huggingface/text-embeddings-inference:cpu-1.9 --model-id BAAI/bge-reranker-base
