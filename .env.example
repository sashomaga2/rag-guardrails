# --- Model provider ---------------------------------------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...            # if you switch RAG_CHAT_MODEL to anthropic:...

# --- LangSmith tracing + evaluation -------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=northwind-rag
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU data residency

# --- App settings (all optional; defaults in src/northwind_rag/config.py) -----
RAG_OFFLINE=false
RAG_CHAT_MODEL=openai:gpt-4.1-mini
RAG_GUARD_MODEL=openai:gpt-4.1-nano
RAG_JUDGE_MODEL=openai:gpt-4.1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.25
